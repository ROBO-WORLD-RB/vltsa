PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/orders.sqlite
# Set on the server only. Never include this key in frontend JavaScript.
OXAPAY_MERCHANT_API_KEY=
# Live payments use false. Hosted invoice testing can opt in to true.
# OxaPay's on-site white-label cryptocurrency flow requires live mode.
OXAPAY_SANDBOX=false

# Authoritative order storage for Netlify and the local server
ORDER_STORE=appwrite
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6ade8087000aa3c64299
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=6ade818d0031c9a9b0ce
APPWRITE_ORDERS_COLLECTION_ID=6ade81b10015d2db4bd5
APPWRITE_RESERVATIONS_TABLE_ID=reservations
APPWRITE_EVENTS_TABLE_ID=payment_events
